<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WeChat_Notifier.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WeChat_Notifier"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="微信通知 · WeChat-Notifier"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Language="zh-CN">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="微信通知" Subtitle="WeChat-Notifier">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="Left" OpenPaneLength="204"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="外观" Tag="appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="行为" Tag="behaviour">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="快捷键" Tag="hotkeys">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="高级" Tag="advanced">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="20,0,16,20" Spacing="8">
                    <TextBlock Text="运行状态" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="ConnectionText" Text="等待微信" TextWrapping="Wrap"
                               Style="{StaticResource SettingsHint}" MaxLines="3" />
                    <Button x:Name="PauseButton" Content="暂停通知" Click="OnPause"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid Padding="28,12,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <TextBlock x:Name="PageTitle" Text="外观" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="PageDescription" Text="选择通知方式，调整气泡布局与玻璃材质。"
                               Style="{StaticResource SettingsHint}" />
                </StackPanel>
                <InfoBar x:Name="Feedback" Grid.Row="1" IsOpen="False" IsClosable="True"
                         Severity="Error" Margin="0,0,0,12" />
                <ContentControl x:Name="PageHost" Grid.Row="2"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </NavigationView>

        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="恢复默认" Click="OnReset" />
                <TextBlock x:Name="DirtyText" Grid.Column="1" Text="所有修改已保存"
                           Style="{StaticResource SettingsHint}" VerticalAlignment="Center" Margin="8,0" />
                <Button Grid.Column="2" Content="预览通知" Click="OnPreview" />
                <Button Grid.Column="3" Content="关闭" Click="OnClose" />
                <Button x:Name="SaveButton" Grid.Column="4" Content="保存"
                        Style="{StaticResource AccentButtonStyle}" Click="OnSave">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
