<Page x:Class="WeChat_Notifier.Views.Pages.HotkeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="0,0,12,20">
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="与微信共用同一个快捷键"
                     Message="微信未运行时由本程序接管热键并启动微信；微信运行后释放热键，由微信负责显示与隐藏。请在微信设置中保持相同快捷键。" />
            <TextBlock Text="微信热键" Style="{StaticResource SettingsSection}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="HotkeyStatus" Text="正在读取热键状态" Style="{StaticResource SettingsHint}" />
                    <ToggleSwitch Header="启用微信启动热键" IsOn="{x:Bind ViewModel.WeChatHotkeyEnabled, Mode=TwoWay}" />
                    <TextBox x:Name="HotkeyInput" Header="显示 / 隐藏快捷键" IsReadOnly="True"
                             Text="{x:Bind ViewModel.WeChatHotkey, Mode=OneWay}"
                             PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp" GotFocus="OnHotkeyGotFocus" LostFocus="OnHotkeyLostFocus" />
                    <TextBlock Text="点击输入框后直接按组合键。Esc 退出录制，Backspace 清除并停用热键。支持 Ctrl、Alt、Shift、Win 与字母、数字、逗号、句号、F1～F24。"
                               Style="{StaticResource SettingsHint}" />
                </StackPanel>
            </Border>
            <TextBlock Text="模式切换热键" Style="{StaticResource SettingsSection}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ModeHotkeyStatus" Style="{StaticResource SettingsHint}" />
                    <ToggleSwitch Header="启用模式切换热键"
                                  IsOn="{x:Bind ViewModel.ModeSwitchHotkeyEnabled, Mode=TwoWay}" />
                    <TextBox x:Name="ModeHotkeyInput" Header="循环切换：正常 → 隐私 → 静默" IsReadOnly="True"
                             Text="{x:Bind ViewModel.ModeSwitchHotkey, Mode=OneWay}"
                             PreviewKeyDown="OnHotkeyKeyDown" PreviewKeyUp="OnHotkeyKeyUp" GotFocus="OnHotkeyGotFocus" LostFocus="OnHotkeyLostFocus" />
                    <TextBlock Text="默认 Ctrl+Alt+,+.，同时按住 Ctrl、Alt、逗号与句号四个键。点击输入框录制，标点键松开后完成；Esc 取消，Backspace 清除并停用。保存后生效。"
                               Style="{StaticResource SettingsHint}" />
                </StackPanel>
            </Border>
            <TextBlock Text="启动路径" Style="{StaticResource SettingsSection}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <TextBox Header="微信启动程序（.exe）"
                             Text="{x:Bind ViewModel.WeChatPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="选择程序" Click="OnBrowse" />
                        <Button Content="使用运行中的微信路径" Click="OnDetect" />
                    </StackPanel>
                    <TextBlock Text="仅在微信尚未运行时使用；不会在点击通知时自动搜索聊天。" Style="{StaticResource SettingsHint}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
