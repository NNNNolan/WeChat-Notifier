<Page x:Class="WeChat_Notifier.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="0,0,12,20">
            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="52" Height="52" VerticalAlignment="Top"
                           AutomationProperties.Name="微信通知图标" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="WeChat-Notifier" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="BuildInfo" Text="WinUI 3 · Native AOT" Style="{StaticResource SettingsHint}" />
                        <TextBlock Text="作者：NNNNolan" Style="{StaticResource SettingsHint}" />
                        <TextBlock Text="只监听微信 Windows 4.x 新消息；原版液态玻璃气泡与 Windows 系统横幅可切换。"
                                   Style="{StaticResource SettingsHint}" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="文件位置" Style="{StaticResource SettingsSection}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <TextBox Header="配置文件" IsReadOnly="True" Text="{x:Bind ViewModel.ConfigPath}" />
                    <Button Content="打开配置文件" Click="OnOpenConfig" HorizontalAlignment="Left" />
                    <TextBox Header="日志文件" IsReadOnly="True" Text="{x:Bind ViewModel.LogPath}" />
                    <Button Content="打开日志目录" Click="OnOpenLog" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <TextBlock Text="本地读取与隐私" Style="{StaticResource SettingsSection}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="消息读取和通知均在本机完成，不联网、不上传聊天内容。只读取会话、联系人和企业会话摘要，不打开完整消息正文库。"
                               Style="{StaticResource SettingsHint}" />
                    <TextBlock Text="数据库密钥从本机缓存或微信进程的只读扫描获得，可能触发安全软件提示。仅在个人本机上使用，程序和微信应以普通权限运行。"
                               Style="{StaticResource SettingsHint}" />
                    <TextBlock Text="连续消息可能合并为最新摘要。微信内部数据库格式变化后可能需要更新适配。"
                               Style="{StaticResource SettingsHint}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
