<Page x:Class="WeChat_Notifier.Views.Pages.BehaviourPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="0,0,12,20">
            <TextBlock Text="启动" Style="{StaticResource SettingsSection}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="8">
                    <ToggleSwitch Header="开机自动启动" IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}" />
                    <TextBlock Text="登录 Windows 后在托盘后台启动，不自动打开设置窗口。保存后生效。"
                               Style="{StaticResource SettingsHint}" />
                </StackPanel>
            </Border>
            <TextBlock Text="通知规则" Style="{StaticResource SettingsSection}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <ToggleSwitch x:Name="SkipMutedToggle" Header="跳过消息免打扰的会话"
                                  IsOn="{x:Bind ViewModel.SkipMuted, Mode=TwoWay}" />
                    <ToggleSwitch Header="仅未读数增加时通知" IsOn="{x:Bind ViewModel.SkipOwnMessages, Mode=TwoWay}" />
                    <TextBlock Text="避免自己发出的消息和正在查看的聊天触发通知。首次连接、恢复通知与重载配置只建立基线，不补弹历史未读。"
                               Style="{StaticResource SettingsHint}" />
                    <ToggleSwitch Header="包含公众号 / 服务号" IsOn="{x:Bind ViewModel.IncludeOfficialAccounts, Mode=TwoWay}" />
                    <ToggleSwitch x:Name="ForegroundToggle" Header="微信在前台时不打扰"
                                  IsOn="{x:Bind ViewModel.SuppressForActiveChat, Mode=TwoWay}" />
                    <TextBlock Text="微信主窗口、聊天窗口或设置窗口在前台时不弹出通知，也不补弹这段时间的消息。最小化、隐藏到托盘或在后台时正常通知。"
                               Style="{StaticResource SettingsHint}" />
                    <ToggleSwitch Header="全屏应用运行时不打扰" IsOn="{x:Bind ViewModel.SuppressWhenFullscreen, Mode=TwoWay}" />
                    <TextBlock Text="全屏和演示期间不显示气泡或横幅，消息仍保存到通知中心。"
                               Style="{StaticResource SettingsHint}" />
                </StackPanel>
            </Border>
            <TextBlock Text="忽略名单" Style="{StaticResource SettingsSection}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <TextBox Header="精确忽略的会话名称或 ID"
                             Text="{x:Bind ViewModel.SkipSessionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="用中文或英文逗号分隔，名称或 ID 完全一致时忽略。企业会话也支持完整标题。"
                               Style="{StaticResource SettingsHint}" />
                    <TextBox Header="会话名称包含这些关键字时忽略"
                             Text="{x:Bind ViewModel.SkipKeywordsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="用逗号分隔，例如：拼车, 代购。" Style="{StaticResource SettingsHint}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <TextBlock Text="点击通知只唤起微信，不搜索或切换聊天。微信未运行时，使用快捷键页设置的启动路径。"
                           Style="{StaticResource SettingsHint}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
